# MONA repo (github.com/JayD108/Mona) — WHITELIST: ignore everything, then allow MONA's code.
# Data, tokens, model weights and run logs never go to git (many GB; some data is personal-use only).
/*

!/.gitignore
!/README.md
!/LICENSE
!/requirements-mona.txt

!/mona/
!/learn/

!/pipeline/
/pipeline/*
!/pipeline/mona_*.py

!/scripts/
/scripts/*
!/scripts/mona_*.py

!/ops/
/ops/*.lock

!/docs/
/docs/*
!/docs/MONA_PLAN.md
!/docs/MONA_LAB_PLAN.md

__pycache__/
*.pyc
